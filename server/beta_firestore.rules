// beta_firestore.rules: the Firestore rules for the beta
// =======================================================
// No client reads or writes Firestore directly. A player's launcher reaches a
// galaxy only through the relay (functions/relay.py), which uses admin
// credentials, and the referee uses a service account. Neither is governed by
// security rules, so the rules deny everything.
//
// This is the ruleset deployed to cs-resurgence (released 21 September 2026,
// read back from the Firebase Rules API on 7 October 2026).
//
// A rule that allowed any signed-in client to read a galaxy document would
// serve `seats` (uid to civ) and `joined`, which the relay withholds on purpose
// (relay.PRIVATE_FIELDS), and with anonymous sign-in "signed in" is anyone.
// Field-level access is enforced in the relay, where it can be expressed.
//
// There is deliberately no firebase.json beside this file. The only Hosting
// config is site/firebase.json, which serves the live website, so rules are
// deployed by hand, from a directory whose firebase.json names nothing else:
//
//     firebase deploy --only firestore:rules

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
