// beta_storage.rules: the Cloud Storage rules for the beta
// =========================================================
// No client reads or writes the bucket through the Firebase SDK. A launcher
// downloads a turn through a signed URL the relay hands it, and a launcher
// from before H13 uploads through a signed URL too; a signed URL is authorised
// by its signature, not by these rules. The relay and the referee use service
// accounts, which bypass rules. So the rules deny everything.
//
// This is the ruleset deployed to cs-resurgence (released 21 September 2026,
// read back from the Firebase Rules API on 7 October 2026). The Storage
// emulator is given a copy by functions/emulators.py.
//
// A rule allowing signed-in clients to create submission objects would let
// anyone, since anonymous sign-in is free, write any civ's object and fill the
// bucket. Submission size is capped by the relay (`MAX_BYTES`, 1 MiB of base64)
// and the store (`MAX_SUBMISSION_DATA`), not here.
//
// Deployed by hand, as `firebase deploy --only storage`, for the reason
// beta_firestore.rules gives.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
