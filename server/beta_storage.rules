// beta_storage.rules , proposed Cloud Storage rules for the beta relay
// =====================================================================
// NOT DEPLOYED. Written for review, and item H4's to deploy. The note in
// beta_firestore.rules about there being no firebase.json beside these files
// applies here for the same reason.
//
// The layout firebase_store.py writes to Cloud Storage:
//
//     beta/<galaxy>/turns/0007.b64            the state for turn 7
//
// Submissions and notes are Firestore documents (plan item H13), stored and
// served by the relay's `POST /<galaxy>/submission/<n>/<civ>` and
// `GET /<galaxy>/note/<n>/<civ>`, and they are not in this bucket. Two object
// paths remain for the changeover H13 describes:
//
//     beta/<galaxy>/submissions/0007/X.b64    turns from before a galaxy's
//     beta/<galaxy>/notes/0007/X.txt          `submissions_from`, read only
//
// A galaxy started or published since H13 carries `submissions_from`, and
// nothing reads or writes those paths for its later turns. The one writer
// left is a launcher holding an upload ticket handed out before the relay was
// redeployed, which names a signed URL for up to `URL_SECONDS`; the relay's
// commit reads that object back, stores it as a document and deletes it.
//
// The worker holds a service account and bypasses these rules, so nothing
// below grants the worker anything. A signed URL is authorised by its
// signature and not by these rules either. Everything here is what a client
// using the Firebase SDK directly may do, and no launcher does that: every
// launcher request goes through the relay, which checks the seat in code.
//
// WHAT THESE RULES CANNOT EXPRESS
// -------------------------------
// H4 asks that a client may write only *its own* submission. A Storage rule
// can test `request.auth.uid` and custom claims and nothing else about who is
// asking. A submission object is named for the civ, which is a username the
// player typed, and there is no relation a rule can evaluate between a uid and
// a username. So `allow write: if request.auth != null` below lets any signed
// in client write any civ's submission object, which is not an ownership rule
// and should not be described as one. Ownership is enforced by the relay's
// seat map, on the Firestore document the relay writes.
//
// The 2 MB size test on the submission path below predates H13 and is not the
// cap a submission is held to. The relay caps a submission body at
// `MAX_BYTES`, 1 MiB of base64, and the store refuses one over
// `MAX_SUBMISSION_DATA` before Firestore can.
//
// A player reaches its own submission through `store.submission(civ, turn)`,
// one document read at the relay (plan item H6), so `read: if false` on the
// submission path costs a launcher nothing.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // A published turn. Every player downloads it; nobody but the worker
    // writes it. This is the whole galaxy, which every player holds already,
    // for the reason D1 and D2 in the blob push plan record.
    match /beta/{galaxy}/turns/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // A submission object from before H13. See the note above: this is a
    // size cap and a deletion refusal, and not an ownership rule.
    match /beta/{galaxy}/submissions/{turn}/{file} {
      allow read: if false;
      allow create, update: if request.auth != null
                            && request.resource.size < 2 * 1024 * 1024
                            && request.resource.contentType.matches('text/.*');
      allow delete: if false;
    }

    // A note object from before H13. Readable by anyone signed in for the
    // same reason the roster is: the object is named for the civ, so a rule
    // cannot tell whose it is. A note says which of a player's own orders were
    // refused, which is not worth a redesign to hide, and N2's dropped
    // submission notes are the same shape.
    match /beta/{galaxy}/notes/{turn}/{file} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Everything else, including anything the website ever puts in this
    // bucket, is denied by default and is left that way.
  }
}
