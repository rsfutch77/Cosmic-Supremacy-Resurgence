# ── Runtime server artifacts ──────────────────────────────────────────────────
cs_server.log
save_game_*.dat
save_gov_*.dat
server/*.sqlite3
server/.venv/
# captured savegame blobs, and the blob loadgame injects when present
server/saves/
server/loadgame_blob.b64
# raw blobs handed to the client as its command-line argument at startup
client/*.dat
# ...except the Single Player galaxy, which is not a throwaway capture but a
# shipped release asset: build.ps1 copies it into the zip, so a checkout without
# it cannot build a release at all.
!client/SinglePlayerGalaxy.dat

# ── Build / debug leftovers ───────────────────────────────────────────────────
*.hex
*.log
*.dmp
__pycache__/

# ── Dev tool output ───────────────────────────────────────────────────────────
client/dev_tools/snapshots/
# the AI's persistent fog-of-war map: per machine, per galaxy, per civ , game
# state rather than source, and meaningless in another checkout
client/dev_tools/ai_player/state/
*.exe.bak
# patch-script backups, which name the patch they precede
*.exe.*.bak
# the player client: CosmicSupremacy_TestBed.exe with the coat-of-arms prompt
# patched out, built by client/dev_tools/patch_hide_setup_prompts.py --build.
# A patched binary belongs beside the tracked one, never in place of it.
client/CosmicSupremacy_Player.exe
tools

# named restore points (raw save blobs, big and regenerable)
client/checkpoints/

# a live galaxy's turn store: every turn's blob, every submission, the clock.
# Game state rather than source, it grows with every turn, and a checkout is
# not where a running galaxy belongs. server/turn_store.py describes the layout.
server/galaxy_*/
.vscode

# ── Release build output ──────────────────────────────────────────────────────
# The staged release folder duplicates the 8 MB client binaries that are already
# tracked in client/ , it is an artifact of release/build.ps1, regenerable from
# the manifest, and belongs on a GitHub release rather than in the history.
dist/
release/build/
release/.venv-build/
# written by launcher.py when it is run from a checkout rather than a release
release/data/

# ── Claude Code local config ──────────────────────────────────────────────────
# per-developer tool permissions and agent settings; not project source
.claude/

# ── Rehosted archive site ─────────────────────────────────────────────────────
# site/ is tracked: the Firebase config, the 404 page, the staging script and
# any hand-written page overrides are real source. What is NOT tracked is
# public/, which stage.py rebuilds from scratch out of the untracked mirror
# under tools/wayback/, and the Firebase CLI's local cache.
site/public/
site/.firebase/
site/*.log
referee_work/
server/fog_work/
server/wipe_work/
