# The emulator suite's demo project, and nothing else. The Firebase CLI loads
# .env.<project-id> only when that project is the active one, and the live
# project is cs-resurgence, so nothing set here can reach it. The emulator sets
# FIRESTORE_EMULATOR_HOST and FIREBASE_AUTH_EMULATOR_HOST for a function itself;
# it does not set the one the Cloud Storage client library reads, which is why
# that one is here.
STORAGE_EMULATOR_HOST=http://127.0.0.1:9199
CS_RELAY_PROJECT=demo-cs-resurgence
CS_RELAY_BUCKET=demo-cs-resurgence.firebasestorage.app
